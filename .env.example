# Database Configuration
DB_HOST=your_database_host
DB_USER=your_username
DB_PASSWORD=your_password
DB_PORT=3306

# AWS Bedrock Configuration for Claude API
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Optional: Specific model configuration
# Available Claude models on Bedrock:
# - anthropic.claude-3-sonnet-20240229-v1:0 (balanced performance/cost)
# - anthropic.claude-3-haiku-20240307-v1:0 (fastest, cheapest)
# - anthropic.claude-3-opus-20240229-v1:0 (highest quality, most expensive)
